  "matrix_formats": {
    "4x4_row_major": {
      "rows": 4,
      "cols": 4,
      "size_bytes": 64,
      "description": "Standard 4x4 matrix, row-major layout (DirectX style)"
    },
    "4x4_column_major": {
      "rows": 4,
      "cols": 4,
      "size_bytes": 64,
      "description": "4x4 matrix, column-major layout (OpenGL style)"
    },
    "4x3_row_major": {
      "rows": 4,
      "cols": 3,
      "size_bytes": 48,
      "description": "Compact 4x3 matrix (no bottom row), row-major"
    },
    "3x4_column_major": {
      "rows": 3,
      "cols": 4,
      "size_bytes": 48,
      "description": "Compact 3x4 matrix (transposed 4x3), column-major"
    }
  },

  "vertex_formats": {
    "xyzw_float": {
      "size_bytes": 16,
      "components": ["x", "y", "z", "w"],
      "type": "float32",
      "description": "Standard XYZW float vector"
    },
    "xyz_float_pad": {
      "size_bytes": 16,
      "components": ["x", "y", "z", "pad"],
      "type": "float32",
      "description": "XYZ float with padding"
    }
  }
}
